# ===========================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# Без них приложение не запустится
# ===========================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5488/company_analyzer

# JWT Secret (минимум 32 символа!)
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# ===========================================
# GOOGLE VERTEX AI (для анализа компаний)
# ===========================================

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
VERTEX_AI_LOCATION=us-central1

# ===========================================
# APPLICATION URLS
# ===========================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# ОПЦИОНАЛЬНЫЕ (нужны в production)
# ===========================================

# ЮKassa (оплата)
YUKASSA_SHOP_ID=your-shop-id
YUKASSA_SECRET_KEY=your-secret-key

# Email (SMTP)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@metalvector.ru
SMTP_PASSWORD=your-app-password
SMTP_FROM="МеталлВектор <noreply@metalvector.ru>"

# ===========================================
# ENVIRONMENT
# ===========================================

NODE_ENV=development
